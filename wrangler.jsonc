{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "ivorist",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "send_email": [
    { "name": "SEND_EMAIL", "destination_addresses": ["hemalviral2011@gmail.com"] }
  ],
  //_DOMAIN_ROUTES_ custom domains (uncomment after the conflicting DNS
  // records for ivorists.com / www are removed from the zone):
  // "routes": [
  //   { "pattern": "ivorists.com", "custom_domain": true },
  //   { "pattern": "www.ivorists.com", "custom_domain": true }
  // ]
}
