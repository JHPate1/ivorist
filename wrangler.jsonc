{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "ivorist",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "send_email": [
    { "name": "SEND_EMAIL", "allowed_destination_addresses": ["hemalviral2011@gmail.com"] }
  ],
  // Custom domain (attached). www is handled by a Cloudflare redirect
  // rule that points to the apex, so only the apex lives here.
  "routes": [
    { "pattern": "ivorists.com", "custom_domain": true }
  ]
}
