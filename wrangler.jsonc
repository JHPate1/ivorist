{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "ivorist",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "send_email": [
    { "name": "SEND_EMAIL", "allowed_destination_addresses": ["hemalviral2011@gmail.com"] }
  ],
  // Live routing notes:
  // - ivorists.com is attached in the Cloudflare dashboard (Workers custom
  //   domain state), not here: the zone DNS for the apex is externally
  //   managed, so a config route here would conflict. Leave routes out of
  //   wrangler.jsonc unless the DNS ownership changes.
  // - www.ivorists.com is a Cloudflare redirect to the apex.
  "workers_dev": true
}
